@@ -2,6 +2,40 @@ import XCTest
 @testable import CoreModels
 
 final class AppVersionIdentityTests: XCTestCase {
+    func testPersonalReleaseMatchesUpstreamWhileRetainingInstallationBuild() {
+        let identity = AppVersionIdentity(infoDictionary: [
+            "CFBundleIdentifier": "com.thatcube.Plozz.personal-advanced",
+            "CFBundleShortVersionString": "2026.10.30",
+            "CFBundleVersion": "4900.1",
+            "PlozzDevelopmentFeature": "Personal advanced",
+            "PlozzPersonalUpstreamVersion": "2026.11.3",
+            "PlozzPersonalUpstreamBuild": "69.2"
+        ])
+        XCTAssertEqual(identity.displayVersion, "2026.11.3")
+        XCTAssertEqual(identity.displayBuild, "69.2")
+        XCTAssertEqual(identity.build, "4900.1")
+        XCTAssertEqual(identity.marketingVersion, "2026.10.30")
+    }
+
+    func testPersonalMetadataCannotRelabelOfficialAppOrIncompleteBuild() {
+        for overrides in [
+            ["CFBundleIdentifier": "com.thatcube.Plozz"],
+            ["PlozzPersonalUpstreamVersion": ""],
+            ["PlozzPersonalUpstreamBuild": "$(PLOZZ_PERSONAL_UPSTREAM_BUILD)"]
+        ] {
+            let info = [
+                "CFBundleIdentifier": "com.thatcube.Plozz.personal-advanced",
+                "CFBundleShortVersionString": "2026.10.30",
+                "CFBundleVersion": "4900.1",
+                "PlozzPersonalUpstreamVersion": "2026.11.3",
+                "PlozzPersonalUpstreamBuild": "69.2"
+            ].merging(overrides) { _, override in override }
+            let identity = AppVersionIdentity(infoDictionary: info)
+            XCTAssertEqual(identity.displayVersion, "2026.10.30")
+            XCTAssertEqual(identity.displayBuild, "4900.1")
+        }
+    }
