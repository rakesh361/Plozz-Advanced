diff --git a/Tests/CoreModelsTests/AppVersionIdentityTests.swift b/Tests/CoreModelsTests/AppVersionIdentityTests.swift
index 81da59f..d25c845 100644
--- a/Tests/CoreModelsTests/AppVersionIdentityTests.swift
+++ b/Tests/CoreModelsTests/AppVersionIdentityTests.swift
@@ -2,6 +2,60 @@ import XCTest
 @testable import CoreModels
 
 final class AppVersionIdentityTests: XCTestCase {
+    func testPersonalReleaseShowsUpstreamNumberWhileRetainingInstallationBuild() {
+        let identity = AppVersionIdentity(infoDictionary: [
+            "CFBundleIdentifier": "com.thatcube.Plozz.personal-advanced",
+            "CFBundleShortVersionString": "2026.10.30",
+            "CFBundleVersion": "4900.1",
+            "PlozzDevelopmentFeature": "Personal advanced",
+            "PlozzPersonalBuild": true,
+            "PlozzPersonalUpstreamVersion": "2026.11.3",
+            "PlozzPersonalUpstreamBuild": "69.2"
+        ])
+        XCTAssertEqual(identity.displayVersion, "69.2")
+        XCTAssertEqual(identity.releaseVersion, "2026.11.3")
+        XCTAssertEqual(identity.displayBuild, "69.2")
+        XCTAssertEqual(identity.build, "4900.1")
+        XCTAssertEqual(identity.marketingVersion, "2026.10.30")
+    }
+
+    func testResignedPersonalReleaseKeepsUpstreamVersion() {
+        for identifier in ["com.thatcube.Plozz.personal-advanced", "com.resigned.Plozz.ABC123", ""] {
+            let identity = AppVersionIdentity(infoDictionary: [
+                "CFBundleIdentifier": identifier,
+                "CFBundleShortVersionString": "2026.11.6",
+                "CFBundleVersion": "6009.1",
+                "PlozzDevelopmentFeature": "Personal advanced",
+                "PlozzPersonalBuild": true,
+                "PlozzPersonalUpstreamVersion": "2026.11.6",
+                "PlozzPersonalUpstreamBuild": "71.1"
+            ])
+            XCTAssertEqual(identity.displayVersion, "71.1")
+            XCTAssertEqual(identity.displayBuild, "71.1")
+            XCTAssertEqual(identity.build, "6009.1")
+        }
+    }
+
+    func testPersonalMetadataCannotRelabelOfficialAppOrIncompleteBuild() {
+        for overrides: [String: Any] in [
+            ["PlozzPersonalBuild": false],
+            ["PlozzPersonalUpstreamVersion": ""],
+            ["PlozzPersonalUpstreamBuild": "$(PLOZZ_PERSONAL_UPSTREAM_BUILD)"]
+        ] {
+            let info: [String: Any] = [
+                "CFBundleIdentifier": "com.thatcube.Plozz.personal-advanced",
+                "CFBundleShortVersionString": "2026.10.30",
+                "CFBundleVersion": "4900.1",
+                "PlozzPersonalBuild": true,
+            "PlozzPersonalUpstreamVersion": "2026.11.3",
+                "PlozzPersonalUpstreamBuild": "69.2"
+            ].merging(overrides) { _, override in override }
+            let identity = AppVersionIdentity(infoDictionary: info)
+            XCTAssertEqual(identity.displayVersion, "2026.10.30")
+            XCTAssertEqual(identity.displayBuild, "4900.1")
+        }
+    }
+
